# Database connection string for PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartrouteai

# development | staging | production
APP_ENV=development
# api 
PROCESS_ROLE=api
ENABLE_TRACKING_BROADCAST=true
# Set true only if you are NOT running `python worker.py` separately (e.g.
# local single-process dev). Leave false in docker-compose deployments, which
# already run scheduled jobs in their own dedicated worker service.
ENABLE_BACKGROUND_JOBS_IN_API=false
LOG_LEVEL=INFO



# Stadia api key
STADIA_API_KEY=
STADIA_GEOCODER_URL=https://api.stadiamaps.com/geocoding/v1
STADIA_ROUTER_URL=https://api.stadiamaps.com/route/v1
STADIA_MATRIX_URL=https://api.stadiamaps.com/matrix/v1
STADIA_NEAREST_ROADS_URL=https://api.stadiamaps.com/nearest_roads/v1
STADIA_MAP_MATCH_URL=https://api.stadiamaps.com/map_match/v1


# auto - Need right plan
STADIA_ROUTING_COSTING=auto
STADIA_TILES_URL=https://tiles.stadiamaps.com
STADIA_MAP_STYLE_PATH=styles/alidade_smooth.json

#allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# configuring Clerk
AUTH_PROVIDER=clerk
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-domain>

# Optional:
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173


# Native Clerk clients
CLERK_ALLOW_NATIVE_CLIENTS=true
