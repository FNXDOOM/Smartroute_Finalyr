[TEMPLATE]
# Database connection string for PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartrouteai

# development | staging | production
APP_ENV=development
# api 
PROCESS_ROLE=api
ENABLE_TRACKING_BROADCAST=true
# Set true only if you are NOT running `python worker.py` separately (e.g.
# local single-process dev). Leave false in docker-compose deployments, which
# already run scheduled jobs in their own dedicated worker service.
ENABLE_BACKGROUND_JOBS_IN_API=false
LOG_LEVEL=INFO



# Stadia api key
STADIA_API_KEY=
STADIA_GEOCODER_URL=https://api.stadiamaps.com/geocoding/v1
STADIA_ROUTER_URL=https://api.stadiamaps.com/route/v1
STADIA_MATRIX_URL=https://api.stadiamaps.com/matrix/v1
STADIA_NEAREST_ROADS_URL=https://api.stadiamaps.com/nearest_roads/v1
STADIA_MAP_MATCH_URL=https://api.stadiamaps.com/map_match/v1


# auto - Need right plan
STADIA_ROUTING_COSTING=auto
STADIA_TILES_URL=https://tiles.stadiamaps.com
STADIA_MAP_STYLE_PATH=styles/alidade_smooth.json

# Rate limiting / abuse protection (application level — see utils/rate_limit.py).
# Per-client throttling for endpoints and downstream services (DB, Stadia,
# Razorpay, bcrypt). This is NOT DDoS protection — volumetric attacks must be
# absorbed at the proxy/edge layer (NPM, WAF, CDN).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
# JSON-only API: maximum accepted request body in bytes (1 MiB default).
MAX_BODY_BYTES=1048576

# Razorpay payments (https://dashboard.razorpay.com → Settings → API Keys).
# Use rzp_test_* keys for development; never commit real keys here.
# KEY_SECRET and WEBHOOK_SECRET must stay server-side ONLY — they are never
# returned by any endpoint and must never be placed in frontend/.env as VITE_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for webhook signature verification (Settings → Webhooks).
RAZORPAY_WEBHOOK_SECRET=

#allowed frontend origins
# In production (behind Nginx Proxy Manager or any reverse proxy) this MUST
# be your public HTTPS domain, e.g. https://app.example.com -- not localhost.
ALLOWED_ORIGINS=http://localhost:5173

# configuring Clerk
AUTH_PROVIDER=clerk
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-domain>
CLERK_SECRET_KEY=sk_test_replace_me

# Optional:
CLERK_AUDIENCE=
# Must also be your public HTTPS domain in production, matching ALLOWED_ORIGINS.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173


# Native Clerk clients
CLERK_ALLOW_NATIVE_CLIENTS=true

# Local email/password auth for the Flutter mobile app.
# The Flutter app logs in via POST /auth/register + POST /auth/login and
# receives an HS256 JWT signed with this secret. Clerk web auth is unaffected.
LOCAL_JWT_SECRET=
LOCAL_JWT_EXPIRES_MINUTES=10080
