DATABASE_URL=postgresql://postgres:password@localhost:5432/smartrouteai

# development | staging | production
APP_ENV=development
# api serves HTTP/WebSockets; worker runs scheduled jobs
PROCESS_ROLE=api
ENABLE_TRACKING_BROADCAST=true
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins, e.g. http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Set to clerk after configuring Clerk. Keep Clerk credentials server-side.
AUTH_PROVIDER=clerk
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-domain>

# Optional:
CLERK_AUDIENCE=

CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Native Clerk clients
CLERK_ALLOW_NATIVE_CLIENTS=true
