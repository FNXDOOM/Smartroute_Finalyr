# Docker matches a bare pattern only at the context root, so `**/` is required
# to keep nested env files, key material and caches out of the API image.
**/.env
**/.env.*
!**/.env.example

**/*.pem
**/*.key
**/*.p12

**/*.db
**/*.sqlite
**/*.sqlite3
**/__pycache__
**/*.py[cod]
**/.pytest_cache
.testdb/
.commandcode/

.git
.gitignore
.vscode
.coverage

frontend/node_modules
frontend/dist
backend/.venv
venv
.venv

**/Dockerfile*
**/docker-compose*.yml
**/docker-compose*.yaml
