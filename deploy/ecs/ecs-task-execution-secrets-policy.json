{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSmartRouteProductionSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:smartrouteai/production/*"
      ]
    }
  ]
}
