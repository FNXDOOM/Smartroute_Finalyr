VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_API_BASE_URL=http://127.0.0.1:8000
# Map provider. Set one key for production vector maps; without a key the app
# uses a CARTO raster fallback through MapLibre so local demos still work.
VITE_MAP_STYLE_URL=
VITE_STADIA_API_KEY=
VITE_MAPTILER_KEY=
# Geocoder provider: photon (keyless fallback), maptiler, or stadia.
VITE_GEOCODER_PROVIDER=photon
# Optional custom geocoder endpoint for the photon fallback.
VITE_GEOCODER_URL=https://photon.komoot.io/api
# Optional OSRM or Valhalla endpoint for route validation and ETA.
VITE_ROUTER_URL=
VITE_ROUTER_ENGINE=osrm
